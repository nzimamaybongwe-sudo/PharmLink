# PharmLink Environment Configuration
# Copy this file to .env and fill in your values

# Flask
SECRET_KEY=change-this-to-a-long-random-secret-key
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True

# Database (WAMP MySQL/MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pharmlink_db
DB_USER=root
DB_PASSWORD=

# Mail (optional - for future email notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# App settings
APP_NAME=PharmLink
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=16777216

